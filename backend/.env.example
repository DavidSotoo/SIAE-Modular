DATABASE_URL=postgresql://siae_admin:siae_dev_password@127.0.0.1:15432/siae_modular
# Obligatorio: sin esta variable el backend se niega a emitir tokens.
JWT_SECRET=change_this_in_production
PORT=4000
NODE_ENV=development

# Origenes permitidos por CORS, separados por coma. Si se deja vacio en
# desarrollo se usan los puertos locales de Vite; en produccion es obligatorio.
# CORS_ORIGINS=https://siae-modular.vercel.app

# Opcional: el Client ID del proyecto ya viene por defecto en el código
# (googleAuth.service.ts). Solo ponlo si quieres usar otro cliente OAuth;
# debe coincidir con VITE_GOOGLE_CLIENT_ID del frontend.
# GOOGLE_CLIENT_ID=

# Correos de Google autorizados como administrador, separados por coma.
# No dependen de dominio institucional (pueden ser @academicos.udg.mx o Gmail).
ADMIN_EMAILS=ricardo.barajas@ejemplo.com
