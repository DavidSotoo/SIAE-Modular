DATABASE_URL=postgresql://siae_admin:siae_dev_password@127.0.0.1:15432/siae_modular
JWT_SECRET=change_this_in_production
PORT=4000
NODE_ENV=development

# OAuth Client ID de Google Cloud Console (tipo "Web application").
# Debe coincidir con el que usa el frontend (VITE_GOOGLE_CLIENT_ID).
GOOGLE_CLIENT_ID=

# Correos de Google autorizados como administrador, separados por coma.
# No dependen de dominio institucional (pueden ser @academicos.udg.mx o Gmail).
ADMIN_EMAILS=ricardo.barajas@ejemplo.com
