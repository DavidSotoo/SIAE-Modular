{
  "name": "siae-modular",
  "private": true,
  "type": "module",
  "description": "Herramientas de calidad compartidas por backend y frontend. El codigo de la app vive en backend/ y frontend/, cada uno con su propio package.json.",
  "scripts": {
    "lint": "eslint backend/src backend/tests frontend/src e2e playwright.config.ts",
    "lint:fix": "eslint backend/src backend/tests frontend/src e2e playwright.config.ts --fix",
    "format": "prettier --write \"{backend,frontend}/src/**/*.{ts,css}\" \"backend/tests/**/*.ts\" \"e2e/**/*.ts\" playwright.config.ts frontend/vite.config.ts",
    "format:check": "prettier --check \"{backend,frontend}/src/**/*.{ts,css}\" \"backend/tests/**/*.ts\" \"e2e/**/*.ts\" playwright.config.ts frontend/vite.config.ts",
    "prepare": "husky",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck:e2e": "tsc -p e2e"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md,yml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.23.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsonwebtoken": "^9.0.3",
    "lint-staged": "^16.4.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.71.2"
  }
}
